    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "koffi": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
