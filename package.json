  "private": true,
  "description": "Fishtank desktop app",
  "main": "src/desktop/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "build": "vite build --config src/frontend/vite.config.mts",
